# sshd runs as uid 1000 (no root in the container) and knows only the user "dev".
Port 2222
HostKey /etc/devbox/ssh/ssh_host_ed25519_key
PidFile /tmp/sshd.pid
AllowUsers dev

PubkeyAuthentication yes
AuthorizedKeysFile /etc/devbox/ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
# The key files are mounted read-only and belong to the host.
StrictModes no

# Only from the laptop into the container (to view the dev server), never the other way round.
AllowTcpForwarding local
GatewayPorts no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no

ClientAliveInterval 60
ClientAliveCountMax 10
PrintMotd no
Subsystem sftp internal-sftp
