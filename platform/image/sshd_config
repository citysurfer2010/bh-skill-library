# sshd laeuft als uid 1000 (kein root im Container) und kennt nur den User "dev".
Port 2222
HostKey /etc/devbox/ssh/ssh_host_ed25519_key
PidFile /tmp/sshd.pid
AllowUsers dev

PubkeyAuthentication yes
AuthorizedKeysFile /etc/devbox/ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
# Die Key-Dateien sind schreibgeschuetzt eingehaengt und gehoeren dem Host.
StrictModes no

# Nur vom Laptop in den Container (Dev-Server ansehen), nie umgekehrt.
AllowTcpForwarding local
GatewayPorts no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no

ClientAliveInterval 60
ClientAliveCountMax 10
PrintMotd no
Subsystem sftp internal-sftp
