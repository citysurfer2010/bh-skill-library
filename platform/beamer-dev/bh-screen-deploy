#!/usr/bin/env bash
# Registers the profile BH for the command line (plain-text passwords, the CLI does not know the GUI encryption),
# packages BH Screen, grants the Beamer the install permission and installs the app.
set -uo pipefail
H=/home/tizen; TS=$H/tizen-studio; T=$TS/tools/ide/bin/tizen; S=$TS/tools/sdb; C=$H/SamsungCertificate/BH; ENV=/srv/bh-platform/.env
P=$H/tizen-studio-data/profile/profiles.xml; B=$(sed -n 's/^BH_BEAMER_IP=//p' $ENV | tail -1); PW=$(sed -n 's/^BH_TIZEN_AUTHOR_PW=//p' $ENV | tail -1)
[ -n "$PW" ] || { echo "BH_TIZEN_AUTHOR_PW fehlt in $ENV"; exit 1; }
run(){ runuser -u tizen -- bash -c "cd $H && export PATH=/usr/local/bin:\$PATH; $*" </dev/null; }
p12ok(){ openssl pkcs12 -in "$1" -passin pass:"$2" -noout -legacy 2>/dev/null || openssl pkcs12 -in "$1" -passin pass:"$2" -noout 2>/dev/null; }
p12ok $C/author.p12 "$PW" || { echo "Autoren-Passwort passt nicht"; exit 2; }
DPW=""; for cand in "$PW" tizenpkcs12passfordsigner; do p12ok $C/distributor.p12 "$cand" && { DPW=$cand; break; }; done
[ -n "$DPW" ] || { echo "Distributor-Passwort unbekannt"; exit 3; }
echo "DUID laut Geraet: $(run "$S -s $B:26101 shell 0 getduid" 2>/dev/null | tail -1) | im Zertifikat: $(openssl x509 -in $C/distributor.crt -noout -ext subjectAltName | grep -oE 'deviceid=[^,]+' | cut -d= -f2)"
cp -n $P $P.gui-backup 2>/dev/null
runuser -u tizen -- python3 -I - "$P" "$C" "$PW" "$DPW" <<'PY'
import sys
p, c, pw, dpw = sys.argv[1:5]
x = lambda s: s.replace('&', '&amp;').replace('"', '&quot;').replace('<', '&lt;')
open(p, 'w').write(f'''<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<profiles active="BH" version="3.1">
<profile name="BH">
<profileitem ca="" distributor="0" key="{c}/author.p12" password="{x(pw)}" rootca=""/>
<profileitem ca="" distributor="1" key="{c}/distributor.p12" password="{x(dpw)}" rootca=""/>
<profileitem ca="" distributor="2" key="" password="" rootca=""/>
</profile>
</profiles>
''')
PY
chmod 600 $P
# config.js (address with secret) stays in place, everything else always comes from the repo.
for f in config.xml index.html style.css icon.png $(cd /opt/bh-skill-library/skills/bh-beamer/app && ls *.js | grep -vx config.js); do install -m 644 -o tizen -g tizen /opt/bh-skill-library/skills/bh-beamer/app/$f $H/bhscreen/$f; done
rm -rf $H/bhscreen/.buildResult $H/bhscreen/*signature*.xml $H/bhscreen/BHScreen.wgt
run "cd bhscreen && $T build-web -- ." >/dev/null 2>&1
run "cd bhscreen && $T package -t wgt -s BH -- .buildResult" 2>&1 | grep -iE 'error|Package File' | tail -1 | cut -c1-120
W=$(ls $H/bhscreen/.buildResult/*.wgt 2>/dev/null | head -1); [ -n "$W" ] || { grep -iE 'exception' $H/tizen-studio-data/cli/logs/cli.log | grep -v '^\s*at ' | tail -1 | cut -c1-160; exit 4; }
mv -f "$W" $H/bhscreen/BHScreen.wgt; echo "Paket: BHScreen.wgt $(stat -c %s $H/bhscreen/BHScreen.wgt) Bytes"
run "$S connect $B:26101" >/dev/null 2>&1
run "$S -s $B:26101 push $C/device-profile.xml /home/owner/share/tmp/sdk_tools/device-profile.xml" >/dev/null 2>&1
run "$S -s $B:26101 push $H/bhscreen/BHScreen.wgt /home/owner/share/tmp/sdk_tools/tmp/BHScreen.wgt" >/dev/null 2>&1
run "$S -s $B:26101 shell 0 vd_appinstall bhscreen01 /home/owner/share/tmp/sdk_tools/tmp/BHScreen.wgt" 2>&1 | grep -E 'install (ok|failed)|ok' | tail -1 | cut -c1-170
run "$S -s $B:26101 shell 0 was_execute bhscreen01.BHScreen" >/dev/null 2>&1; sleep 5
curl -s -m 6 http://$B:8001/api/v2/applications/bhscreen01.BHScreen | jq -c '{name,running,visible,version}'
