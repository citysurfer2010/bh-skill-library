'use strict';
/**
 * HTTP client for __APP_NAME__. All paths prefixed with window.APP_BASE.
 * me() is cached for 60 s so the navbar is ready immediately on page changes.
 */
window.__NS__Api = (() => {
  const BASE = (typeof window !== 'undefined' && window.APP_BASE) || '';

  async function req(method, url, body) {
    const opts = { method, credentials: 'same-origin', headers: {} };
    if (body !== undefined) {
      opts.headers['Content-Type'] = 'application/json';
      opts.body = JSON.stringify(body);
    }
    const fullUrl = url.startsWith('/') ? (BASE + url) : url;
    const r = await fetch(fullUrl, opts);
    const ct = r.headers.get('content-type') || '';
    const data = ct.includes('application/json') ? await r.json().catch(() => null) : null;
    if (!r.ok) {
      const msg = (data && data.error) || `HTTP ${r.status}`;
      const err = new Error(msg); err.status = r.status; err.data = data;
      throw err;
    }
    return data;
  }

  async function me() {
    try {
      const raw = sessionStorage.getItem('__SLUG__-me');
      if (raw) {
        const c = JSON.parse(raw);
        if (c && c._cachedAt && Date.now() - c._cachedAt < 60000) {
          const { _cachedAt, ...user } = c;
          return user;
        }
      }
    } catch {/* cache miss */}
    const fresh = await req('GET', '/api/me');
    try { sessionStorage.setItem('__SLUG__-me', JSON.stringify({ ...fresh, _cachedAt: Date.now() })); } catch {}
    return fresh;
  }

  return { me /* add more endpoints here */ };
})();
