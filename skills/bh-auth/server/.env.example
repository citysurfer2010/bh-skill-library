# Oeffentliche Adresse der Anmeldung, zwingend mit https in Produktion
PUBLIC_URL=https://auth.example.com
# Fuer mehrere Apps unter einer Domain, sonst leer lassen
AUTH_COOKIE_DOMAIN=
# Google-Login ist nur aktiv, wenn beide Werte gesetzt sind (OAuth-Client vom Typ Webanwendung)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
